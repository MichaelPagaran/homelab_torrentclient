# Host folder where completed and in-progress downloads are stored (required).
DOWNLOADS_PATH=/Users/you/Downloads/torrents

# Host folder for qBittorrent settings and state.
CONFIG_PATH=./config

# Run as your host user so files are owned by you (macOS: `id -u` / `id -g`).
PUID=501
PGID=20

TZ=America/New_York
WEBUI_PORT=8080
TORRENTING_PORT=6881

# Optional: pin an image version instead of latest.
# QBT_VERSION=latest
